# Copy to server/.env. Everything is optional. CrowdKart works with no keys:
# real stores/restaurants + addresses come from OpenStreetMap, routes from OSRM.

PORT=4000
# Long random string, so logins survive restarts.
JWT_SECRET=

# ---- Live stores, restaurants & address search ----
# Optional. With a Google Maps key, stores come from Google Places (ratings, open-now,
# far better coverage in India) and address search uses Google Geocoding.
# Enable "Places API (New)" and "Geocoding API" for the key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# ---- More stores & restaurants (add any or all; results are combined) ----
# TomTom: free 2,500 requests/day, no credit card. developer.tomtom.com → Dashboard → Keys
TOMTOM_API_KEY=
# Ola Maps (India): maps.olakrutrim.com → create a project → copy its API key
OLA_MAPS_API_KEY=
# Delivery radius for stores, in km
STORE_RADIUS_KM=5
# How long to cache store lists per area (minutes)
PLACES_CACHE_MIN=60
# Optional self-hosted services (defaults are the public OpenStreetMap servers)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org

# ---- AI (Gemini via router.bynara.id, OpenAI-compatible) ----
AI_BASE_URL=https://router.bynara.id/v1
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---- Razorpay: UPI (GPay, PhonePe, Paytm, BHIM), cards, netbanking, wallets ----
# Dashboard → Account & Settings → API Keys. Use rzp_test_ keys first, rzp_live_ after KYC.
# Without Razorpay or PayPal keys, payments run in test mode (no money moves).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard → Webhooks → URL https://<your-server>/api/razorpay/webhook,
# events payment.captured + order.paid, and paste the secret you set there:
RAZORPAY_WEBHOOK_SECRET=

# ---- PayPal (optional, for international payments) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_INR_PER_UNIT=84
PAYPAL_WEBHOOK_ID=

# ---- Matching ----
MATCH_THRESHOLD=60
GROUP_WINDOW_MIN=10
# Neighbours must live within this distance of each other to share a rider (km)
DROP_RADIUS_KM=0.6
# Rider movement speed on the tracking map (until a real rider app is connected)
RIDER_SIM_SPEED_KMH=60

# Promo codes customers can apply in the cart, e.g. WELCOME10:10,CROWD15:15 (code:percent)
PROMO_CODES=
